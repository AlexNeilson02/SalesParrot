# SQLite connection string. Relative paths resolve against the project root.
DATABASE_URL="file:./prisma/dev.db"

# Secret used to sign session cookies. Generate your own with: openssl rand -hex 32
AUTH_SECRET="replace-me-with-a-random-hex-string"

# Optional. Map tiles default to OpenStreetMap, whose tile server is meant for
# light traffic — point these at a commercial provider before putting a team on it.
# NEXT_PUBLIC_MAP_TILE_URL="https://{s}.tile.example.com/{z}/{x}/{y}.png?key=..."
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION="&copy; Your tile provider"
